{
  "manifest_version": 3,
  "name": "Address & Shipping Label Maker - Labeloo",
  "short_name": "Labeloo",
  "version": "0.5.2",
  "description": "Create and print address, shipping, name badge, and custom labels from text or spreadsheets on Avery-compatible US Letter sheets.",
  "permissions": ["storage", "contextMenus", "identity"],
  "optional_host_permissions": ["https://auth.wiplash.ai/*", "https://docs.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Labeloo",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "96": "assets/icons/icon96.png",
    "128": "assets/icons/icon128.png"
  },
  "options_page": "app.html"
}
